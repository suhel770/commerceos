// ============================================================================
// CommerceOS Master Enterprise Database Schema (PostgreSQL)
// Authoritative Single Source of Truth for Multi-Tenant E-Commerce ERP
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// 1. ENUMS (RBAC, Listing, Marketplace & Order Domain States)
// ----------------------------------------------------------------------------

enum CommerceRole {
  OWNER
  SUPER_ADMIN
  ADMIN
  PRODUCT_MANAGER
  LISTING_MANAGER
  INVENTORY_MANAGER
  WAREHOUSE_MANAGER
  ORDER_MANAGER
  FINANCE_MANAGER
  CUSTOMER_SUPPORT
  ANALYST
  READ_ONLY
}

enum ListingStatus {
  DRAFT
  READY
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  ARCHIVED
}

enum MarketplaceName {
  AMAZON
  FLIPKART
  MEESHO
  SHOPIFY
  WOOCOMMERCE
  AJIO
  MYNTRA
}

enum MarketplacePublishStatus {
  NOT_CONNECTED
  NOT_PUBLISHED
  VALIDATING
  READY
  PUBLISHING
  PUBLISHED
  FAILED
  SYNCING
}

enum AttributeRequirement {
  REQUIRED
  RECOMMENDED
  OPTIONAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

// ----------------------------------------------------------------------------
// 2. TENANTS & ACCESS CONTROL (Multi-Tenant Membership RBAC)
// ----------------------------------------------------------------------------

model Organization {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  workspaces           Workspace[]
  members              OrganizationMember[]
  storageLocations     StorageLocation[]
  storageStocks        StorageStock[]
  storageReceipts      StorageReceipt[]
  storageReceiptLines  StorageReceiptLine[]
  storageOperationLogs StorageOperationLog[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Workspace {
  id                     String                  @id @default(uuid())
  organizationId         String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  code                   String                  @default("ws-default")
  members                WorkspaceMember[]
  products               Product[]
  masterListings         MasterListing[]
  warehouses             Warehouse[]
  orders                 Order[]
  marketplaceConnections MarketplaceConnection[]
  vendors                Vendor[]
  purchaseBills          PurchaseBill[]
  purchaseOrders         PurchaseOrder[]
  storageLocations       StorageLocation[]
  storageStocks          StorageStock[]
  storageReceipts        StorageReceipt[]
  storageReceiptLines    StorageReceiptLine[]
  storageOperationLogs   StorageOperationLog[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  active              Boolean              @default(true)
  organizationMembers OrganizationMember[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model OrganizationMember {
  id               String            @id @default(uuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             CommerceRole      @default(ADMIN)
  workspaceMembers WorkspaceMember[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
}

model WorkspaceMember {
  id                   String             @id @default(uuid())
  organizationId       String
  workspaceId          String
  workspace            Workspace          @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  organizationMemberId String
  organizationMember   OrganizationMember @relation(fields: [organizationId, organizationMemberId], references: [organizationId, id], onDelete: Cascade)
  roleOverride         CommerceRole?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([workspaceId, organizationMemberId])
  @@index([organizationId])
  @@index([workspaceId])
}

// ----------------------------------------------------------------------------
// 3. MASTER PRODUCT CATALOG & MASTER LISTING (Central Source of Truth)
// ----------------------------------------------------------------------------

model Product {
  id                  String               @id @default(uuid())
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku                 String
  slug                String?
  name                String
  brand               String?
  category            String
  subCategory         String?
  barcode             String?
  hsn                 String?
  gstRate             Decimal              @default(18.0) @db.Decimal(5, 2)
  costPrice           Decimal              @default(0.00) @db.Decimal(12, 2)
  sellingPrice        Decimal              @default(0.00) @db.Decimal(12, 2)
  mrp                 Decimal              @default(0.00) @db.Decimal(12, 2)
  status              String               @default("Active")
  images              String[]
  intent              String               @default("sellable")
  masterListing       MasterListing?
  inventoryItems      Inventory[]
  orderItems          OrderItem[]
  purchaseLines       PurchaseBillLine[]
  poLines             PurchaseOrderLine[]
  storageStocks       StorageStock[]
  storageReceiptLines StorageReceiptLine[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@index([category])
}

model MasterListing {
  id                  String                        @id @default(uuid())
  workspaceId         String
  workspace           Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId           String
  product             Product                       @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Cascade)
  revision            Int                           @default(1)
  status              ListingStatus                 @default(DRAFT)
  shortDescription    String?
  description         String?
  bulletPoints        String[]
  attributes          MasterAttribute[]
  attributeMappings   MarketplaceAttributeMapping[]
  marketplaceListings MarketplaceListing[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, productId])
  @@index([workspaceId])
  @@index([productId])
  @@index([status])
}

model MasterAttribute {
  id              String        @id @default(uuid())
  masterListingId String
  masterListing   MasterListing @relation(fields: [masterListingId], references: [id], onDelete: Cascade)
  key             String
  label           String
  value           String
  group           String        @default("general")

  @@unique([masterListingId, key])
  @@index([masterListingId])
}

// ----------------------------------------------------------------------------
// 4. MARKETPLACE INTEGRATIONS & DYNAMIC ATTRIBUTE MAPPING
// ----------------------------------------------------------------------------

model MarketplaceConnection {
  id                   String               @id @default(uuid())
  workspaceId          String
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace          MarketplaceName
  enabled              Boolean              @default(true)
  sellerId             String?
  encryptedCredentials String?              @db.Text
  marketplaceListings  MarketplaceListing[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, marketplace])
  @@index([workspaceId])
}

model MarketplaceListing {
  id                      String                   @id @default(uuid())
  workspaceId             String
  masterListingId         String
  masterListing           MasterListing            @relation(fields: [workspaceId, masterListingId], references: [workspaceId, id], onDelete: Cascade)
  marketplaceConnectionId String
  connection              MarketplaceConnection    @relation(fields: [workspaceId, marketplaceConnectionId], references: [workspaceId, id], onDelete: Cascade)
  marketplaceSku          String
  externalListingId       String?
  title                   String?
  sellingPrice            Decimal                  @db.Decimal(12, 2)
  publishStatus           MarketplacePublishStatus @default(NOT_PUBLISHED)
  listingStatus           String                   @default("Live")
  stockSync               Boolean                  @default(true)
  buyBoxPercentage        Float?
  lastSyncedAt            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([masterListingId, marketplaceConnectionId])
  @@unique([workspaceId, marketplaceConnectionId, marketplaceSku])
  @@index([workspaceId])
  @@index([masterListingId])
  @@index([marketplaceConnectionId])
}

model MarketplaceAttributeMapping {
  id                 String               @id @default(uuid())
  masterListingId    String
  masterListing      MasterListing        @relation(fields: [masterListingId], references: [id], onDelete: Cascade)
  marketplace        MarketplaceName
  marketplaceField   String
  masterAttributeKey String
  requirement        AttributeRequirement @default(OPTIONAL)
  transformedValue   String?

  @@unique([masterListingId, marketplace, marketplaceField])
  @@index([masterListingId])
  @@index([marketplace])
}

// ----------------------------------------------------------------------------
// 5. WAREHOUSE & INVENTORY MANAGEMENT
// ----------------------------------------------------------------------------

model Warehouse {
  id               String            @id @default(uuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code             String
  name             String
  type             String            @default("WAREHOUSE") // WAREHOUSE, HOME, FBA
  address          String?
  active           Boolean           @default(true)
  inventories      Inventory[]
  orderItems       OrderItem[]
  orders           Order[]
  storageLocations StorageLocation[]
  storageReceipts  StorageReceipt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model Inventory {
  id          String    @id @default(uuid())
  workspaceId String
  productId   String
  product     Product   @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [workspaceId, warehouseId], references: [workspaceId, id], onDelete: Cascade)
  sku         String
  available   Int       @default(0)
  reserved    Int       @default(0)
  incoming    Int       @default(0)
  damaged     Int       @default(0)
  inTransit   Int       @default(0)
  safetyStock Int       @default(5)
  intent      String    @default("sellable")
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, productId, warehouseId])
  @@index([workspaceId])
  @@index([productId])
  @@index([warehouseId])
}

// ----------------------------------------------------------------------------
// 6. ORDER MANAGEMENT
// ----------------------------------------------------------------------------

model Order {
  id              String          @id @default(uuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderNumber     String
  channel         MarketplaceName
  externalOrderId String?
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(UNPAID)
  shippingMode    String          @default("STANDARD")
  customerName    String
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?
  warehouseId     String?
  warehouse       Warehouse?      @relation(fields: [workspaceId, warehouseId], references: [workspaceId, id], onDelete: Restrict)
  subtotal        Decimal         @default(0.00) @db.Decimal(12, 2)
  taxTotal        Decimal         @default(0.00) @db.Decimal(12, 2)
  shippingTotal   Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0.00) @db.Decimal(12, 2)
  cancelledAt     DateTime?
  cancelReason    String?
  items           OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, orderNumber])
  @@index([workspaceId])
  @@index([channel])
  @@index([status])
}

model OrderItem {
  id          String     @id @default(uuid())
  workspaceId String
  orderId     String
  order       Order      @relation(fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [workspaceId, warehouseId], references: [workspaceId, id], onDelete: Restrict)
  sku         String
  productName String
  quantity    Int
  unitPrice   Decimal    @db.Decimal(12, 2)
  taxAmount   Decimal    @default(0.00) @db.Decimal(12, 2)
  totalPrice  Decimal    @db.Decimal(12, 2)

  @@index([workspaceId])
  @@index([orderId])
  @@index([productId])
}

// ----------------------------------------------------------------------------
// 7. PURCHASE MODULE (Procurement & Vendor Directory)
// ----------------------------------------------------------------------------

model Vendor {
  id                     String          @id @default(uuid())
  organizationId         String
  workspaceId            String
  workspace              Workspace       @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  name                   String
  registrationType       String          @default("regular")
  gstin                  String?
  pan                    String?
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  contactPerson          String?
  businessCategory       String?
  rating                 Float?          @default(5.0)
  bankName               String?
  bankAccountName        String?
  bankAccountNumber      String?
  bankIfsc               String?
  paymentTermsDays       Int             @default(30)
  leadTimeDays           Int             @default(7)
  notes                  String?
  defaultPurchaseIntent  String?
  allowedPurchaseIntents String[]
  status                 String          @default("active")
  bills                  PurchaseBill[]
  purchaseOrders         PurchaseOrder[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([workspaceId, id])
  @@index([organizationId, workspaceId])
  @@index([status])
}

model PurchaseBill {
  id                  String             @id @default(uuid())
  organizationId      String
  workspaceId         String
  workspace           Workspace          @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  billNumber          String
  poNumber            String?
  poReference         String?
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder?     @relation(fields: [workspaceId, purchaseOrderId], references: [workspaceId, id], onDelete: SetNull)
  vendorInvoiceNumber String?
  vendorId            String
  vendor              Vendor             @relation(fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: Restrict)
  vendorName          String
  purchaseType        String             @default("inventory_product")
  category            String             @default("inventory_product")
  status              String             @default("ordered")
  paymentStatus       String             @default("unpaid")
  paymentMethod       String             @default("credit")
  paymentId           String?
  amountPaid          Decimal            @default(0.00) @db.Decimal(12, 2)
  paymentDate         String?
  instantSettlement   Boolean            @default(false)
  billDate            String
  dueDate             String?
  subtotal            Decimal            @default(0.00) @db.Decimal(12, 2)
  discountAmount      Decimal            @default(0.00) @db.Decimal(12, 2)
  taxPercent          Decimal            @default(0.00) @db.Decimal(5, 2)
  taxAmount           Decimal            @default(0.00) @db.Decimal(12, 2)
  cgstAmount          Decimal            @default(0.00) @db.Decimal(12, 2)
  sgstAmount          Decimal            @default(0.00) @db.Decimal(12, 2)
  igstAmount          Decimal            @default(0.00) @db.Decimal(12, 2)
  freightAmount       Decimal            @default(0.00) @db.Decimal(12, 2)
  otherCharges        Decimal            @default(0.00) @db.Decimal(12, 2)
  roundOff            Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount         Decimal            @default(0.00) @db.Decimal(12, 2)
  interstate          Boolean            @default(false)
  buyerStateCode      String             @default("27")
  buyerGstin          String?
  notes               String?
  billUploadName      String?
  attachments         Json?
  createdBy           String             @default("system")
  createdByName       String?
  updatedBy           String?
  updatedByName       String?
  isDeleted           Boolean            @default(false)
  lines               PurchaseBillLine[]
  payments            PurchasePayment[]
  storageReceipts     StorageReceipt[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, billNumber])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, vendorId])
  @@index([status])
  @@index([paymentStatus])
  @@index([purchaseType])
}

model PurchaseBillLine {
  id           String       @id @default(uuid())
  workspaceId  String
  billId       String
  bill         PurchaseBill @relation(fields: [workspaceId, billId], references: [workspaceId, id], onDelete: Cascade)
  description  String
  quantity     Int
  unitPrice    Decimal      @db.Decimal(12, 2)
  amount       Decimal      @db.Decimal(12, 2)
  qtyDamaged   Int          @default(0)
  uom          String       @default("pcs")
  sku          String?
  hsn          String?
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  gstRate      Decimal      @default(0.00) @db.Decimal(5, 2)
  cgstAmount   Decimal      @default(0.00) @db.Decimal(12, 2)
  sgstAmount   Decimal      @default(0.00) @db.Decimal(12, 2)
  igstAmount   Decimal      @default(0.00) @db.Decimal(12, 2)
  taxAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  intent       String       @default("sellable")
  lineItemType String?
  freightMode  String?
  qcStatus     String?
  qcRecord     Json?

  @@unique([billId, id])
  @@index([workspaceId])
  @@index([billId])
  @@index([productId])
  @@index([sku])
}

model PurchasePayment {
  id            String       @id @default(uuid())
  workspaceId   String
  billId        String
  bill          PurchaseBill @relation(fields: [workspaceId, billId], references: [workspaceId, id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(12, 2)
  paymentMethod String
  paymentDate   String
  referenceId   String?
  notes         String?
  createdBy     String       @default("system")
  createdAt     DateTime     @default(now())

  @@index([workspaceId])
  @@index([billId])
}

model PurchaseOrder {
  id                    String              @id @default(uuid())
  organizationId        String
  workspaceId           String
  workspace             Workspace           @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  poNumber              String
  poDate                String
  expectedDeliveryDate  String?
  deliveryWarehouseId   String?
  warehouseCode         String?
  deliveryWarehouseName String?
  currency              String              @default("INR")
  paymentTerms          String              @default("Net 30")
  vendorReference       String?
  vendorId              String
  vendor                Vendor              @relation(fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: Restrict)
  vendorName            String
  purchaseType          String              @default("inventory_product")
  status                String              @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT_TO_VENDOR, PARTIALLY_RECEIVED, FULLY_RECEIVED, CLOSED, CANCELLED
  subtotal              Decimal             @default(0.00) @db.Decimal(12, 2)
  discountAmount        Decimal             @default(0.00) @db.Decimal(12, 2)
  taxPercent            Decimal             @default(0.00) @db.Decimal(5, 2)
  taxAmount             Decimal             @default(0.00) @db.Decimal(12, 2)
  cgstAmount            Decimal             @default(0.00) @db.Decimal(12, 2)
  sgstAmount            Decimal             @default(0.00) @db.Decimal(12, 2)
  igstAmount            Decimal             @default(0.00) @db.Decimal(12, 2)
  freightAmount         Decimal             @default(0.00) @db.Decimal(12, 2)
  otherCharges          Decimal             @default(0.00) @db.Decimal(12, 2)
  roundOff              Decimal             @default(0.00) @db.Decimal(12, 2)
  totalAmount           Decimal             @default(0.00) @db.Decimal(12, 2)
  interstate            Boolean             @default(false)
  buyerStateCode        String              @default("27")
  notes                 String?
  termsAndConditions    String?
  internalNotes         String?
  vendorContact         String?
  createdBy             String              @default("system")
  createdByName         String?
  updatedBy             String?
  updatedByName         String?
  isDeleted             Boolean             @default(false)
  lines                 PurchaseOrderLine[]
  bills                 PurchaseBill[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, poNumber])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, vendorId])
  @@index([status])
  @@index([purchaseType])
}

model PurchaseOrderLine {
  id           String        @id @default(uuid())
  workspaceId  String
  poId         String
  po           PurchaseOrder @relation(fields: [workspaceId, poId], references: [workspaceId, id], onDelete: Cascade)
  description  String
  quantity     Int
  receivedQty  Int           @default(0)
  billedQty    Int           @default(0)
  unitPrice    Decimal       @db.Decimal(12, 2)
  amount       Decimal       @db.Decimal(12, 2)
  uom          String        @default("pcs")
  sku          String?
  hsn          String?
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  gstRate      Decimal       @default(0.00) @db.Decimal(5, 2)
  cgstAmount   Decimal       @default(0.00) @db.Decimal(12, 2)
  sgstAmount   Decimal       @default(0.00) @db.Decimal(12, 2)
  igstAmount   Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  intent       String        @default("sellable")
  lineItemType String?

  @@unique([poId, id])
  @@index([workspaceId])
  @@index([poId])
  @@index([productId])
  @@index([sku])
}

// ----------------------------------------------------------------------------
// 8. STORAGE MODULE (PHYSICAL LOCATIONS, GRN RECEIVING, OPERATION LOGS)
// ----------------------------------------------------------------------------

model StorageLocation {
  id                    String                @id @default(uuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId           String
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseId           String
  warehouse             Warehouse             @relation(fields: [workspaceId, warehouseId], references: [workspaceId, id], onDelete: Cascade)
  parentLocationId      String?
  parentLocation        StorageLocation?      @relation("SubLocationHierarchy", fields: [workspaceId, parentLocationId], references: [workspaceId, id], onDelete: Cascade)
  subLocations          StorageLocation[]     @relation("SubLocationHierarchy")
  code                  String
  name                  String
  type                  String                @default("warehouse")
  subLocationLevel      String?
  lifecycleState        String                @default("active")
  storageComplexityMode String                @default("simple")
  barcode               String?
  capacityMaxUnits      Int?
  currentUnitsCount     Int                   @default(0)
  isDefault             Boolean               @default(false)
  isArchived            Boolean               @default(false)
  capabilities          String[]
  tags                  String[]
  metadata              Json?                 @default("{}")
  stockItems            StorageStock[]
  receipts              StorageReceipt[]
  sourceOperations      StorageOperationLog[] @relation("SourceLocationOps")
  targetOperations      StorageOperationLog[] @relation("TargetLocationOps")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, warehouseId])
  @@index([workspaceId, parentLocationId])
  @@index([barcode])
}

model StorageStock {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storageLocationId String
  storageLocation   StorageLocation @relation(fields: [workspaceId, storageLocationId], references: [workspaceId, id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  sku               String
  productName       String?
  availableQty      Int             @default(0)
  reservedQty       Int             @default(0)
  damagedQty        Int             @default(0)
  inTransitQty      Int             @default(0)
  intent            String          @default("sellable")
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, storageLocationId, sku])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, storageLocationId])
  @@index([workspaceId, productId])
  @@index([sku])
}

model StorageReceipt {
  id                 String               @id @default(uuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId        String
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseBillId     String?
  purchaseBill       PurchaseBill?        @relation(fields: [workspaceId, purchaseBillId], references: [workspaceId, id], onDelete: Restrict)
  warehouseId        String
  warehouse          Warehouse            @relation(fields: [workspaceId, warehouseId], references: [workspaceId, id], onDelete: Cascade)
  storageLocationId  String?
  storageLocation    StorageLocation?     @relation(fields: [workspaceId, storageLocationId], references: [workspaceId, id], onDelete: Restrict)
  receiptNumber      String
  status             String               @default("pending")
  totalExpectedUnits Int                  @default(0)
  totalReceivedUnits Int                  @default(0)
  totalDamagedUnits  Int                  @default(0)
  receivedByUserId   String?
  notes              String?
  receivedAt         DateTime?
  lines              StorageReceiptLine[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, receiptNumber])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, purchaseBillId])
  @@index([workspaceId, warehouseId])
}

model StorageReceiptLine {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receiptId         String
  receipt           StorageReceipt @relation(fields: [workspaceId, receiptId], references: [workspaceId, id], onDelete: Cascade)
  productId         String?
  product           Product?       @relation(fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  sku               String
  description       String?
  expectedQty       Int            @default(0)
  receivedQty       Int            @default(0)
  damagedQty        Int            @default(0)
  putawayLocationId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([workspaceId, id])
  @@index([organizationId, workspaceId])
  @@index([workspaceId, receiptId])
  @@index([sku])
}

model StorageOperationLog {
  id               String           @id @default(uuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  operationType    String
  sku              String
  qty              Int
  sourceLocationId String?
  sourceLocation   StorageLocation? @relation("SourceLocationOps", fields: [workspaceId, sourceLocationId], references: [workspaceId, id], onDelete: Restrict)
  targetLocationId String?
  targetLocation   StorageLocation? @relation("TargetLocationOps", fields: [workspaceId, targetLocationId], references: [workspaceId, id], onDelete: Restrict)
  actorId          String
  actorName        String
  reason           String?
  metadata         Json?            @default("{}")
  createdAt        DateTime         @default(now())

  @@index([organizationId, workspaceId])
  @@index([workspaceId, sourceLocationId])
  @@index([workspaceId, targetLocationId])
  @@index([sku])
  @@index([createdAt])
}

model InventoryMovement {
  id                String   @id @default(uuid())
  organizationId    String
  workspaceId       String
  sku               String
  productId         String
  warehouseId       String?
  storageLocationId String?
  quantity          Int
  direction         String
  type              String
  reason            String?
  reference         String?
  sourceEntity      String?
  actorId           String?
  actorName         String?
  idempotencyKey    String?  @unique
  metadata          Json?    @default("{}")
  bucketsBefore     Json?
  bucketsAfter      Json?
  intent            String   @default("sellable")
  createdAt         DateTime @default(now())

  @@index([organizationId, workspaceId])
  @@index([sku])
  @@index([warehouseId])
  @@index([storageLocationId])
  @@index([type])
  @@index([reference])
  @@index([createdAt])
}

model InventoryReservation {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String
  productId      String
  sku            String?
  warehouseId    String
  quantity       Int
  status         String
  channel        String?
  orderId        String?
  reference      String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?
  allocatedAt    DateTime?
  fulfilledAt    DateTime?

  @@index([organizationId, workspaceId])
  @@index([productId])
  @@index([sku])
  @@index([status])
  @@index([createdAt])
}

model ChannelAllocationRule {
  id                 String    @id @default(uuid())
  workspaceId        String
  sku                String
  channel            String    // e.g. "amazon", "shopify"
  allocationPercent  Float?
  fixedCap           Int?
  priority           Int?
  safetyBuffer       Int?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, sku, channel])
  @@index([workspaceId, sku])
}

model ConsumableRule {
  id              String   @id @default(uuid())
  organizationId  String
  workspaceId     String
  productId       String?
  productSku      String
  consumableSku   String
  consumableName  String
  quantity        Int      @default(1)
  unit            String   @default("pcs")
  consumptionMode String   @default("PER_UNIT") // PER_UNIT, PER_ORDER
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workspaceId, productSku, consumableSku])
  @@index([organizationId, workspaceId])
  @@index([productSku])
}

// ----------------------------------------------------------------------------
// PHASE 5 — Outbox, Reliable Jobs & Persistent Audit Trail
// ----------------------------------------------------------------------------

/// Transactional outbox record — written atomically with the business mutation.
/// Consumed by OutboxProcessor to drive secondary/async work.
model OutboxEvent {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String
  correlationId  String?
  eventType      String    // e.g. "INVENTORY_ADJUSTED"
  aggregateType  String    // e.g. "Inventory"
  aggregateId    String    // e.g. SKU or entity ID
  payload        Json
  /// PENDING | PROCESSING | PROCESSED | FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  processedAt    DateTime?
  failedAt       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([organizationId, workspaceId])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
}

/// Persistent background job — created by Outbox handlers for async secondary work.
/// idempotencyKey prevents duplicate job creation.
model BackgroundJob {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String
  correlationId  String?
  jobType        String    // e.g. "MARKETPLACE_SYNC"
  outboxEventId  String?   // reference to triggering OutboxEvent
  payload        Json
  idempotencyKey String    @unique
  /// PENDING | PROCESSING | COMPLETED | FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  availableAt    DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([organizationId, workspaceId])
  @@index([jobType])
  @@index([correlationId])
}

/// Immutable, tenant-scoped audit trail record.
/// Never stores passwords, API secrets, or access tokens.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  workspaceId    String
  correlationId  String?
  actorId        String
  actorName      String
  actorRole      String
  action         String   // e.g. "inventory.adjusted"
  entityType     String   // e.g. "Inventory", "PurchaseBill"
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, workspaceId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([correlationId])
  @@index([createdAt])
}
